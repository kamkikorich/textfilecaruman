# =====================================================
# COOLIFY DEPLOYMENT - ENVIRONMENT VARIABLES (TEMPLATE)
# =====================================================
# Copy all these variables into Coolify Dashboard
# Project > Environment Variables
# =====================================================

# -----------------------------------------------------
# DATABASE (REQUIRED - Get from Coolify Database Settings)
# -----------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_IP:5434/textfileskbbk

# -----------------------------------------------------
# AUTHENTICATION (REQUIRED - MUST CHANGE!)
# -----------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_GENERATED_SECRET
NEXTAUTH_URL=https://waju.my

# -----------------------------------------------------
# APP INFO (REQUIRED)
# -----------------------------------------------------
NEXT_PUBLIC_APP_NAME=TextFileSKBBK SaaS
NEXT_PUBLIC_APP_URL=https://waju.my

# -----------------------------------------------------
# EMAIL - Dynamail (REQUIRED)
# -----------------------------------------------------
SMTP_HOST=mail9.dynamail.asia
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@example.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_SECURE=false

# -----------------------------------------------------
# PAYMENT - Billplz (REQUIRED for payments)
# Get from: https://www.billplz.com/enterprise/api
# -----------------------------------------------------
BILLPLZ_SECRET_KEY=sk_test_xxxxxx_or_sk_live_xxxxxx
BILLPLZ_WEBHOOK_KEY=whk_xxxxxx
BILLPLZ_FORM_ID=xxxxxx

# -----------------------------------------------------
# SERVER CONFIG (REQUIRED)
# -----------------------------------------------------
NODE_ENV=production
PORT=3000
